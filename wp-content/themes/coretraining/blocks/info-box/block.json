    "attributes": {
        "content": {
            "type": "string",
            "default": ""
        },
        "variant": {
            "type": "string",
            "default": "tip"
        }
    },
    "supports": {
        "html": false
    },
    "editorScript": "coretraining-blocks-editor",
    "render": "file:./render.php"
}
