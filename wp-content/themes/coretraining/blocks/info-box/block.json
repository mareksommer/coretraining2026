{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "coretraining/info-box",
    "title": "Info box",
    "category": "text",
    "icon": "info",
    "description": "Zvýrazněný box — tip, upozornění nebo shrnutí.",
